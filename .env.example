# ==============================================================================
# Intent Hub Configuration Template
# ==============================================================================
# Configuration Hierarchy (Priority: Highest to Lowest):
# 1. Process environment for secrets and explicit startup overrides
# 2. data/settings.json for non-secret editable settings
# 3. Hardcoded Defaults
# ==============================================================================

# --- [Level 2: Infrastructure & Initial Setup] ---
# Note: Most values below are for INITIALIZATION. Once the app is running,
# please use the Web UI (Settings page) to manage your configuration.
# UI changes are saved to data/settings.json; explicit startup environment overrides take precedence.

# --- Infrastructure ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Data Directory (Where settings.json and other data are stored)
INTENT_HUB_DATA_DIR=/app/data

# --- Qdrant Vector Database ---
# Use http://qdrant:6333 if running with Docker Compose
QDRANT_URL=http://app.qdrant.free4inno.com
QDRANT_COLLECTION=intent_hub_routes
QDRANT_API_KEY=

# Complete embedding service URL; no default port is appended
EMBEDDING_SERVICE_URL=http://embedding.free4inno.com/embed
# qwen: {"input":{"texts":[]}} response; tei: {"inputs":[]} response
EMBEDDING_API_FORMAT=tei

# --- LLM Service (Required for Dataset Generation & Diagnostics) ---
# Supported providers: deepseek, openrouter, doubao, qwen, gemini
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- Initial Embedding Settings ---
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
HUGGINGFACE_ACCESS_TOKEN=

# --- Initial Auth Settings ---
AUTH_ENABLED=True
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=
# Multiple API keys can be comma-separated
API_KEYS=

# --- Build Settings ---
NPM_REGISTRY=
PIP_INDEX_URL=

# Unified API aliases. Both explicit /compat namespaces remain available.
API_COMPAT_PROFILE=master
SOURCE_INSTANCE=default
# Supply securely in the process/container environment. No default password.
AUTH_CODE=
# Optional explicit migrated SQLite path (otherwise data/routes.sqlite3).
# ROUTES_CONFIG_PATH=/app/data/unified.sqlite3
