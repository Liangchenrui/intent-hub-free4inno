{
  "openapi": "3.0.3",
  "info": {
    "title": "Intent Hub API",
    "version": "1.1.0",
    "description": "Agent synchronization and intent routing API protected by the fixed Bearer authentication code telestar."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {"name": "Routing"},
    {"name": "Agents"},
    {"name": "Synchronization"},
    {"name": "Settings"},
    {"name": "System"}
  ],
  "paths": {
    "/route": {
      "post": {
        "tags": ["Routing"],
        "summary": "Route a user query to the best matching Agent",
        "operationId": "routeQuery",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/RouteRequest"},
              "example": {"query": "帮我查询明天北京的天气"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Routing completed. Check data.matched to distinguish a match from the default route.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/RouteResponse"},
                "examples": {
                  "matched": {
                    "summary": "Agent matched",
                    "value": {
                      "success": true,
                      "data": {
                        "matched": true,
                        "agent": {"id": 7, "title": "天气 Agent"},
                        "score": 0.91,
                        "text": null
                      },
                      "error": null
                    }
                  },
                  "notMatched": {
                    "summary": "No Agent passed its threshold",
                    "value": {
                      "success": true,
                      "data": {
                        "matched": false,
                        "agent": null,
                        "score": null,
                        "text": "none"
                      },
                      "error": null
                    }
                  }
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/agents": {
      "get": {
        "tags": ["Agents"],
        "summary": "List synchronized Agents",
        "operationId": "listAgents",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Agent list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/Agent"}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/agents/{agent_id}/diff": {
      "get": {
        "tags": ["Agents"],
        "summary": "Compare local Agent content with its latest upstream snapshot",
        "operationId": "getAgentDiff",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "agent_id", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {
            "description": "Field-level comparison",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgentDiff"}}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/agents/{agent_id}/thresholds": {
      "patch": {
        "tags": ["Agents"],
        "summary": "Update an Agent's routing thresholds",
        "operationId": "updateAgentThresholds",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {"type": "integer"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ThresholdRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated Agent",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Agent"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/sync": {
      "post": {
        "tags": ["Synchronization"],
        "summary": "Synchronize upstream Agents incrementally or with a blue-green rebuild",
        "operationId": "syncAgents",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/SyncRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronization result",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SyncResult"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/sync/status": {
      "get": {
        "tags": ["Synchronization"],
        "summary": "Get synchronization status",
        "operationId": "getSyncStatus",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Synchronization status",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/SyncStatus"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/settings": {
      "get": {
        "tags": ["Settings"],
        "summary": "Get the Qdrant collection setting",
        "operationId": "getSettings",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Current settings",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Settings"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      },
      "post": {
        "tags": ["Settings"],
        "summary": "Update the Qdrant collection setting",
        "operationId": "updateSettings",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/Settings"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated settings",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Settings"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "500": {"$ref": "#/components/responses/InternalError"}
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check service health",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/HealthResponse"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Static code (telestar)"
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"},
            "example": {
              "success": false,
              "data": null,
              "error": {
                "code": "INVALID_REQUEST",
                "message": "请求参数错误",
                "detail": "query must not be empty"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid, or expired API key",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"},
            "example": {
              "success": false,
              "data": null,
              "error": {
                "code": "UNAUTHORIZED",
                "message": "Authentication failed",
                "detail": null
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal service error",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"},
            "example": {
              "success": false,
              "data": null,
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "服务异常",
                "detail": "error detail"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "RouteRequest": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {"type": "string", "minLength": 1}
        }
      },
      "RouteResponse": {
        "type": "object",
        "required": ["success", "data", "error"],
        "properties": {
          "success": {"type": "boolean", "enum": [true]},
          "data": {"$ref": "#/components/schemas/RouteData"},
          "error": {"type": "object", "nullable": true}
        }
      },
      "RouteData": {
        "type": "object",
        "required": ["matched", "agent", "score", "text"],
        "properties": {
          "matched": {"type": "boolean"},
          "agent": {
            "allOf": [{"$ref": "#/components/schemas/AgentDetails"}],
            "nullable": true
          },
          "score": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 1,
            "nullable": true
          },
          "text": {"type": "string", "nullable": true}
        }
      },
      "AgentDetails": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"}
        },
        "additionalProperties": true
      },
      "Agent": {
        "type": "object",
        "required": ["id", "title", "text", "utterances", "negative_samples", "score_threshold", "negative_threshold", "details"],
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "text": {"type": "string"},
          "utterances": {"type": "array", "items": {"type": "string"}},
          "negative_samples": {"type": "array", "items": {"type": "string"}},
          "score_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "negative_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "details": {"type": "object", "additionalProperties": true},
          "upstream_present": {"type": "boolean", "nullable": true},
          "comparison": {"$ref": "#/components/schemas/AgentComparison"}
        }
      },
      "AgentComparison": {
        "type": "object",
        "required": ["status", "diff_fields", "diff_count", "override_fields", "locked_equal_fields"],
        "properties": {
          "status": {"type": "string", "enum": ["same", "local_modified", "locked_equal", "upstream_missing", "local_only", "snapshot_unknown"]},
          "diff_fields": {"type": "array", "items": {"type": "string"}},
          "diff_count": {"type": "integer"},
          "override_fields": {"type": "array", "items": {"type": "string"}},
          "locked_equal_fields": {"type": "array", "items": {"type": "string"}}
        }
      },
      "AgentDiff": {
        "type": "object",
        "required": ["agent_id", "comparison", "fields"],
        "properties": {
          "agent_id": {"type": "integer"},
          "compared_at": {"type": "string", "format": "date-time", "nullable": true},
          "comparison": {"$ref": "#/components/schemas/AgentComparison"},
          "fields": {"type": "object", "additionalProperties": true}
        }
      },
      "ThresholdRequest": {
        "type": "object",
        "required": ["score_threshold", "negative_threshold"],
        "properties": {
          "score_threshold": {"type": "number", "minimum": 0, "maximum": 1},
          "negative_threshold": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "SyncResult": {
        "type": "object",
        "required": ["mode", "agents_count", "indexed_agents_count", "changed_agents", "deleted_agents", "unchanged_agents", "positive_points", "negative_points"],
        "properties": {
          "mode": {"type": "string", "enum": ["incremental", "full"]},
          "agents_count": {"type": "integer"},
          "indexed_agents_count": {"type": "integer"},
          "changed_agents": {"type": "integer"},
          "deleted_agents": {"type": "integer"},
          "unchanged_agents": {"type": "integer"},
          "positive_points": {"type": "integer"},
          "negative_points": {"type": "integer"},
          "collection": {"type": "string"},
          "warning": {"type": "string"}
        }
      },
      "SyncRequest": {
        "type": "object",
        "properties": {
          "mode": {"type": "string", "enum": ["incremental", "full"], "default": "incremental"}
        }
      },
      "SyncStatus": {
        "type": "object",
        "required": ["agents_count", "collection", "expected_points", "points_count", "synced"],
        "properties": {
          "agents_count": {"type": "integer"},
          "collection": {"type": "string"},
          "expected_points": {"type": "integer"},
          "points_count": {"type": "integer"},
          "synced": {"type": "boolean"}
        }
      },
      "Settings": {
        "type": "object",
        "required": ["QDRANT_COLLECTION"],
        "properties": {
          "QDRANT_COLLECTION": {"type": "string"}
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"type": "string", "enum": ["ok"]}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "data", "error"],
        "properties": {
          "success": {"type": "boolean", "enum": [false]},
          "data": {"type": "object", "nullable": true},
          "error": {"$ref": "#/components/schemas/ErrorDetail"}
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message", "detail"],
        "properties": {
          "code": {"type": "string", "enum": ["INVALID_REQUEST", "UNAUTHORIZED", "INTERNAL_ERROR"]},
          "message": {"type": "string"},
          "detail": {"type": "string", "nullable": true}
        }
      }
    }
  }
}
